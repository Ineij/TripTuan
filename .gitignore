# ── Python ──────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.pyc

# ── OS / editor ─────────────────────────────────────────
.DS_Store

# ── Secrets (never commit real keys) ────────────────────
.env
.env.local
frontend/.env.local

# Local Claude Code config — settings.local.json captures command history
# that can include real API keys/bearer tokens, plus machine-specific paths.
.claude/

# ── Local SQLite state (regenerated at runtime) ─────────
*.sqlite
*.sqlite3
*.db
*.sqlite.bak.*

# ── Generated assets (poster + POI illustrations) ───────
# Keep the directory (.gitkeep) but ignore the rendered PNG/SVG output.
backend/static/generated/**/*.png
backend/static/generated/**/*.svg
!backend/static/generated/transport/highspeed_train.png
!backend/static/generated/transport/taxi.png
!backend/static/generated/pois/
!backend/static/generated/pois/csv-preview/
!backend/static/generated/pois/csv-preview/*.png

# ── Node / Vite (frontend) ──────────────────────────────
node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo

# ── Runtime logs ────────────────────────────────────────
logs/
*.log
