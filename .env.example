# Copy to .env.development or .env.local for local dev.
# Vite only exposes vars prefixed with VITE_.

# Base URL for the backend. Leave empty to use mock data (default).
# Example: VITE_API_BASE=http://localhost:8080
VITE_API_BASE=

# Set to "false" once the backend is wired up to skip the in-memory mocks.
# Defaults to true (mock) when unset.
VITE_USE_MOCK=true
