# Copy to .env.local for local dev.
# Vite only exposes vars prefixed with VITE_.

# Base URL of the FastAPI backend.
#   - Leave empty to call same-origin (works when the frontend is served by the
#     backend's built dist, or when a dev proxy is configured).
#   - For the split dev setup (Vite @5173 + uvicorn @8000), point it at the API.
#     `start.py` injects this automatically; only set it manually if you run the
#     frontend on its own.
# Example: VITE_API_BASE=http://127.0.0.1:8000
VITE_API_BASE=
